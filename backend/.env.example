OPENAI_API_KEY=
DATABASE_URL=sqlite:///./tuvigiadinh.db
SECRET_KEY=your-secret-key-here
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXP_HOURS=24
# Google OAuth Client ID (from Google Cloud Console, OAuth 2.0 Web client).
# Frontend reads this value via GET /api/auth/config.
GOOGLE_CLIENT_ID=
# Allow small time drift between Google token issue time and server clock (seconds).
GOOGLE_TOKEN_CLOCK_SKEW_SECONDS=60
# Set to "false" to allow public access (no login required) - for local dev only
AUTH_ENABLED=true
