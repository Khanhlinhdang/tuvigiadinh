OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
DATABASE_URL=sqlite:///./tuvigiadinh.db
SECRET_KEY=your-secret-key-here
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXP_HOURS=24
# Google OAuth Client ID (from Google Cloud Console). Must match the
# client id used by the frontend (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Set to "false" to allow public access (no login required) - for local dev only
AUTH_ENABLED=true
