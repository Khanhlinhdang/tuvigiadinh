NEXT_PUBLIC_API_URL=http://localhost:8000
# Google OAuth Client ID (from Google Cloud Console).
# Backend env vars: GOOGLE_CLIENT_ID (same value), JWT_SECRET (required for
# production - any random string), AUTH_ENABLED (default true), DEV_MODE
# (set to true ONLY for local dev when google-auth library is unavailable).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
