# Root environment for docker-compose
# Copy to .env and fill values.

# Optional: OpenAI online analysis
OPENAI_API_KEY=

# Required for Google login when AUTH_ENABLED=true
GOOGLE_CLIENT_ID=

# JWT signing secret for backend sessions
JWT_SECRET=change-me-local-dev

# Auth controls
AUTH_ENABLED=true
DEV_MODE=false

# Frontend API endpoint (used by Next.js container)
NEXT_PUBLIC_API_URL=http://localhost:8000
